#!/bin/bash
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
mount -t proc proc /proc || exec /bin/bash
mount -t sysfs sysfs /sys || exec /bin/bash
mount -t devtmpfs devtmpfs /dev || true
exec </dev/console >/dev/console 2>&1
echo 'R353: guarded R351 single PGFSM_STATUS observation; exact token required; configfs netconsole proof first'
marker() { printf '<0>R353 NETGUARD: %s\n' "$*" >/dev/kmsg; }
hold() {
    echo 'R353 stopped in initramfs. No root filesystem mounted. No automatic reboot.'
    echo 'To return to normal Bazzite: type reboot -f, then select normal entry.'
    while true; do /bin/bash --noprofile --norc; sleep 1; done
}
fail() { marker "FAIL $*"; echo "R353 FAIL: $*"; hold; }
[[ $(uname -r) == '7.2.3+' ]] || fail 'wrong research kernel'
[[ ! -d /sys/module/amdgpu ]] || fail 'unexpected amdgpu already loaded'
modprobe realtek || fail 'realtek module load'
modprobe r8169 || fail 'r8169 module load'
iface=''
for ((i=0; i<15; i++)); do
    for p in /sys/class/net/*; do
        [[ -e "$p/device" ]] || continue
        [[ $(readlink -f "$p/device") == */0000:04:00.0 ]] || continue
        iface=${p##*/}
    done
    [[ -n "$iface" ]] && break
    sleep 1
done
[[ -n "$iface" ]] || fail 'wired PCI NIC 04:00.0 not found'
ip link set dev "$iface" up || fail 'NIC up'
ip address add 192.168.128.130/24 dev "$iface" || fail 'sender address'
linked=0
for ((i=0; i<30; i++)); do
    read -r carrier <"/sys/class/net/$iface/carrier" || carrier=0
    if [[ "$carrier" == 1 ]]; then linked=1; break; fi
    sleep 1
done
[[ "$linked" == 1 ]] || fail 'no wired link after 30 seconds'
echo "R353 local LINK_READY interface=$iface carrier=1"
modprobe netconsole oops_only=0 "netconsole=+6665@192.168.128.130/$iface,6666@192.168.128.189/8c:1d:55:1b:af:44" || fail 'netconsole module load'
[[ -d /sys/module/netconsole ]] || fail 'netconsole module absent'
[[ ! -d /sys/module/amdgpu ]] || fail 'unexpected GPU module before token'
[[ -d /sys/kernel/config ]] || fail 'configfs unavailable'
mkdir -p /run/r353-configfs || fail 'configfs mountpoint creation'
mount -t configfs configfs /run/r353-configfs || fail 'configfs mount'
cfg=/run/r353-configfs/netconsole
[[ -d "$cfg" ]] || fail 'netconsole configfs subsystem absent'
mkdir "$cfg/cmdline0" || fail 'cannot attach cmdline0 target to configfs'
target="$cfg/cmdline0"
read_attr() { local value; IFS= read -r value <"$target/$1" || return 1; printf '%s' "$value"; }
enabled=$(read_attr enabled) || fail 'cannot read target enabled'
extended=$(read_attr extended) || fail 'cannot read target extended'
dev_name=$(read_attr dev_name) || fail 'cannot read target device'
local_ip=$(read_attr local_ip) || fail 'cannot read target local_ip'
local_port=$(read_attr local_port) || fail 'cannot read target local_port'
remote_ip=$(read_attr remote_ip) || fail 'cannot read target remote_ip'
remote_port=$(read_attr remote_port) || fail 'cannot read target remote_port'
remote_mac=$(read_attr remote_mac) || fail 'cannot read target remote_mac'
transmit_errors=$(read_attr transmit_errors) || fail 'cannot read target transmit_errors'
marker "TARGET enabled=$enabled extended=$extended dev=$dev_name local=$local_ip:$local_port remote=$remote_ip:$remote_port mac=$remote_mac tx_errors=$transmit_errors"
printf 'R353 TARGET enabled=%s extended=%s dev=%s local=%s:%s remote=%s:%s mac=%s tx_errors=%s\n' "$enabled" "$extended" "$dev_name" "$local_ip" "$local_port" "$remote_ip" "$remote_port" "$remote_mac" "$transmit_errors"
[[ "$enabled" == 1 ]] || fail 'netconsole cmdline0 target is DISABLED; GPU not loaded'
[[ "$extended" == 1 ]] || fail 'extended netconsole format is not enabled'
[[ "$dev_name" == "$iface" ]] || fail 'target device mismatch'
[[ "$local_ip" == 192.168.128.130 && "$local_port" == 6665 ]] || fail 'target local endpoint mismatch'
[[ "$remote_ip" == 192.168.128.189 && "$remote_port" == 6666 ]] || fail 'target remote endpoint mismatch'
[[ "${remote_mac,,}" == 8c:1d:55:1b:af:44 ]] || fail 'target receiver MAC mismatch'
[[ ! -d /sys/module/amdgpu ]] || fail 'unexpected GPU module appeared before token'
for ((i=1; i<=10; i++)); do
    marker "QUALIFICATION $i/10 target_enabled=YES amdgpu_absent=YES no_VCN_access"
    sleep 1
done
marker 'QUALIFICATION_COMPLETE; awaiting R353-STATUS-READ; GPU not loaded'
echo 'Save R353 QUALIFICATION_COMPLETE from Windows, then type exactly: R353-STATUS-READ'
export LC_ALL=C
[[ -t 0 ]] && tty_status=YES || tty_status=NO
marker "INPUT_READY stdin_tty=$tty_status expected_bytes=16 diagnostic_only=NO"
stty -a </dev/console
acknowledgement=''
IFS= read -r acknowledgement
read_rc=$?
printf -v escaped '%q' "${acknowledgement:0:64}"
marker "INPUT_RESULT read_rc=$read_rc bytes=${#acknowledgement} escaped_prefix=$escaped"
if ((read_rc != 0)); then
    fail 'INPUT_READ_FAILURE; GPU not loaded'
elif [[ "$acknowledgement" != 'R353-STATUS-READ' ]]; then
    fail 'INPUT_MISMATCH; GPU not loaded'
fi
marker 'INPUT_EXACT_MATCH; receiver confirmation accepted'
[[ ! -d /sys/module/amdgpu ]] || fail 'GPU loaded before gate'
marker 'RECEIVER_CONFIRMED; R351 guarded single PGFSM_STATUS read begins in 5 seconds'
sleep 5
marker 'AMDGPU_MODPROBE_BEGIN; R351 build performs guarded PCI identity checks then one PGFSM_STATUS read; no CONFIG write or wait'
modprobe amdgpu dc=1
rc=$?
marker "UNEXPECTED_MODPROBE_RETURN rc=$rc; do not retry"
hold
